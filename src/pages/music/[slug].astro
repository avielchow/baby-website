---
import { getEntry } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import PianoChord from '../../components/PianoChord.astro';
import VideoCard from '../../components/VideoCard.astro';
import Comments from '../../components/Comments.astro';

const slug = Astro.params.slug;
if (!slug) return Astro.redirect('/music/', 302);

const entry = await getEntry('music', slug);
if (!entry || entry.data.draft) return new Response('Not found', { status: 404 });
const d = entry.data;

const playerData = JSON.stringify({
  tempo: d.tempo,
  week: d.week,
  chords: d.progression.chords.map((c) => ({ bass: c.bass, notes: c.notes, color: c.color })),
});

const SESSIONS = [
  {
    name: 'The held thread',
    blurb: 'One melody note refuses to move while the chords recolor it underneath — then it steps down to close each pass.',
  },
  {
    name: 'Walking the changes',
    blurb: 'The melody lands on a chord tone at every change and strolls stepwise between them — passing tones doing the singing.',
  },
  {
    name: 'Ask & answer',
    blurb: 'A rising two-bar question, a falling two-bar answer that lands on the color notes. The rest in the middle is the question mark.',
  },
];
---

<ContentLayout eyebrow={`Music · Week ${d.week}`} title={`"${d.title}"`} description={d.vibe} lastUpdated={d.lastUpdated}>
  <p class="music-meta reveal">
    <span class="meta-pill">{d.key}</span>
    <span class="meta-pill">{d.tempo} BPM</span>
    <span class="meta-pill">{d.progression.summary}</span>
  </p>

  <section class="week-section" id="listen">
    <h2 class="section-head"><span class="section-icon" set:html={'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V6l11-2v12"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/></svg>'} /> Listen first</h2>
    <p class="section-intro">This is the sound-world of the week — hear where the colors live before you play them.</p>
    <VideoCard title={d.listen.title} url={d.listen.url} channel={d.listen.channel} />
  </section>

  <section class="week-section" id="progression" data-player={playerData}>
    <h2 class="section-head"><span class="section-icon" set:html={'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 5v9M11 5v9M15 5v9M19 5v9"/></svg>'} /> The progression</h2>
    <p class="section-intro">Tap any chord to hear its exact voicing. Loop the whole thing and improvise over it — the loop is the backing band.</p>
    <div class="loop-bar card">
      <button type="button" class="btn" id="loop-btn" data-playing="false">▶ Loop the progression</button>
      <span class="speed-group" role="group" aria-label="Loop speed">
        <button type="button" class="speed-btn is-active" data-speed="1">1×</button>
        <button type="button" class="speed-btn" data-speed="1.5">1.5×</button>
        <button type="button" class="speed-btn" data-speed="2">2×</button>
      </span>
      <span class="loop-hint" id="loop-hint">{d.tempo} BPM · one chord per bar · sound on</span>
    </div>
    <ol class="chord-list">
      {d.progression.chords.map((c, i) => (
        <li class="chord card">
          <div class="chord-head">
            <button type="button" class="chord-play" data-bass={c.bass} data-notes={JSON.stringify(c.notes)} aria-label={`Play ${c.symbol}`}>▶</button>
            <div>
              <p class="chord-symbol">{c.symbol} <span class="chord-roman">{c.roman}</span></p>
              <p class="chord-why">{c.why}</p>
            </div>
          </div>
          <PianoChord notes={c.notes} bass={c.bass} color={c.color} />
        </li>
      ))}
    </ol>
    <p class="legend"><span class="lg lg-bass"></span> bass (left hand) <span class="lg lg-tone"></span> chord tones <span class="lg lg-color"></span> the color notes</p>

    <h3 class="sub-head">Three sample improv sessions — hear it before you play it</h3>
    <p class="section-intro">Each one improvises over this week's loop using a technique from the workshop below. They're generated fresh from the chords, so every session is a little different — like practice is.</p>
    <ol class="session-list">
      {SESSIONS.map((s, i) => (
        <li class="session card">
          <button type="button" class="session-play" data-session={i} data-playing="false" aria-label={`Play improv session: ${s.name}`}>▶</button>
          <div>
            <p class="session-name">Session {i + 1} · {s.name}</p>
            <p class="session-blurb">{s.blurb}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="week-section" id="lh">
    <h2 class="section-head"><span class="section-icon" set:html={'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 11V7a2 2 0 0 1 4 0v4M10 11V5a2 2 0 0 1 4 0v6M14 11V6a2 2 0 0 1 4 0v7a6 6 0 0 1-6 6h-1a6 6 0 0 1-6-6v-2a2 2 0 0 1 4 0"/></svg>'} /> Left hand of the week: {d.lh.name}</h2>
    <p class="section-intro">{d.lh.description}</p>
    <ol class="steps-list">
      {d.lh.steps.map((s) => <li>{s}</li>)}
    </ol>
    <p class="lh-pattern card">One bar over {d.progression.chords[0].symbol}: <strong>{d.lh.pattern}</strong></p>
  </section>

  <section class="week-section" id="melody">
    <h2 class="section-head"><span class="section-icon" set:html={'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17c3-6 6 2 9-4s6 2 9-4"/></svg>'} /> Melody workshop: {d.melody.technique}</h2>
    <p class="section-intro">{d.melody.description}</p>
    <ul class="tools-list">
      {d.melody.tools.map((t) => <li>{t}</li>)}
    </ul>
    <h3 class="sub-head">Three seeds — grow your own tune from any of them</h3>
    <ol class="seed-list">
      {d.melody.seeds.map((s) => (
        <li class="seed card">
          <p class="seed-name">{s.name}</p>
          <p class="seed-phrase">{s.phrase}</p>
          <p class="seed-tip">{s.tip}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="week-section" id="theory">
    <h2 class="section-head"><span class="section-icon" set:html={'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6.5A5.5 5.5 0 1 1 6.5 12M12 6.5V2M12 6.5L8 3"/><circle cx="12" cy="12" r="9.5"/></svg>'} /> Theory bite: {d.theory.title}</h2>
    <ul class="theory-list">
      {d.theory.points.map((p) => <li>{p}</li>)}
    </ul>
  </section>

  <section class="week-section" id="practice">
    <h2 class="section-head"><span class="section-icon" set:html={'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5M9 2h6"/></svg>'} /> The practice recipe (~20 minutes)</h2>
    <ol class="practice-list">
      {d.practice.map((p) => (
        <li class="practice-item card">
          <span class="practice-min">{p.minutes} min</span>
          <span class="practice-what">{p.what}</span>
        </li>
      ))}
    </ol>
  </section>

  <Comments pageId={`music-${d.week}`} backPath={`/music/${slug}/`} />

  <p class="week-nav"><a href="/music/">&larr; All weeks</a></p>
</ContentLayout>

<script>
  // Soft piano-ish WebAudio voice. Tap a chord to hear it; loop the progression
  // (chords struck together, livelier bar pattern, adjustable speed); or play a
  // generated improv session — accompaniment + a melody derived from the week's
  // own voicings, one per workshop technique.
  let ctx: AudioContext | null = null;
  const getCtx = () => (ctx ??= new AudioContext());

  const SEMI: Record<string, number> = { C: 0, 'C#': 1, Db: 1, D: 2, 'D#': 3, Eb: 3, E: 4, F: 5, 'F#': 6, Gb: 6, G: 7, 'G#': 8, Ab: 8, A: 9, 'A#': 10, Bb: 10, B: 11 };
  function midi(note: string): number | null {
    const m = note.trim().match(/^([A-G][#b]?)(\d)$/);
    if (!m) return null;
    return (parseInt(m[2], 10) + 1) * 12 + SEMI[m[1]];
  }
  const mFreq = (m: number) => 440 * Math.pow(2, (m - 69) / 12);

  function voice(f: number, when: number, dur: number, gainDb = 1) {
    const ac = getCtx();
    const g = ac.createGain();
    const lp = ac.createBiquadFilter();
    lp.type = 'lowpass'; lp.frequency.value = Math.min(f * 5, 5200); lp.Q.value = 0.4;
    g.gain.setValueAtTime(0, when);
    g.gain.linearRampToValueAtTime(0.16 * gainDb, when + 0.012);
    g.gain.exponentialRampToValueAtTime(0.0001, when + dur);
    for (const detune of [-4, 3]) {
      const o = ac.createOscillator();
      o.type = 'triangle'; o.frequency.value = f; o.detune.value = detune;
      o.connect(lp); o.start(when); o.stop(when + dur + 0.05);
    }
    lp.connect(g); g.connect(ac.destination);
  }

  const note = (m: number, when: number, dur: number, gain = 1) => voice(mFreq(m), when, dur, gain);

  /** roll=0 → struck together (the loop); a small roll stays on single-chord taps. */
  function playChordM(bassM: number | null, notesM: number[], when: number, dur: number, gain = 1, roll = 0) {
    if (bassM !== null) note(bassM, when, dur, 1.25 * gain);
    notesM.forEach((m, i) => note(m, when + roll * i, dur, 0.9 * gain));
  }

  // Tiny deterministic PRNG so sessions vary run-to-run but never sound broken.
  function mulberry32(seed: number) {
    let a = seed >>> 0;
    return () => {
      a |= 0; a = (a + 0x6D2B79F5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  interface ChordM { bass: number | null; notes: number[]; color: number[] }

  let stopActive: (() => void) | null = null;
  const stopAll = () => { stopActive?.(); stopActive = null; };
  let sessionNonce = 0;

  function init() {
    const section = document.querySelector<HTMLElement>('#progression');
    if (!section) return;
    const data = JSON.parse(section.dataset.player || '{}');
    const chords: ChordM[] = (data.chords || []).map((c: { bass: string; notes: string[]; color?: string[] }) => ({
      bass: midi(c.bass),
      notes: c.notes.map(midi).filter((m: number | null): m is number => m !== null),
      color: (c.color || []).map(midi).filter((m: number | null): m is number => m !== null),
    }));
    const baseBarSec = (60 / (data.tempo || 72)) * 4;

    // Tap-a-chord (dataset.bound guards double-binding: init runs at module
    // load AND on astro:page-load for the initial navigation)
    document.querySelectorAll<HTMLButtonElement>('.chord-play').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        const notes = (JSON.parse(btn.dataset.notes || '[]') as string[]).map(midi).filter((m): m is number => m !== null);
        playChordM(midi(btn.dataset.bass || ''), notes, getCtx().currentTime + 0.02, 2.2, 1, 0.012);
      });
    });

    // ---- The loop: together, livelier, and with a speed control ----
    const loopBtn = document.querySelector<HTMLButtonElement>('#loop-btn');
    const hint = document.querySelector<HTMLElement>('#loop-hint');
    const speedBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.speed-btn'));
    if (!loopBtn || loopBtn.dataset.bound) return;
    loopBtn.dataset.bound = '1';
    let speed = 1;
    let loopTimer: number | null = null;

    const loopBar = (bar: number, barSec: number) => {
      const ac = getCtx();
      const c = chords[bar % chords.length];
      const t = ac.currentTime + 0.03;
      // Beat 1: bass + chord struck together; beat 3: a softer re-strike for pulse.
      playChordM(c.bass, c.notes, t, barSec * 0.95);
      playChordM(null, c.notes, t + barSec / 2, barSec * 0.45, 0.55);
    };

    const stopLoop = () => {
      if (loopTimer !== null) { clearInterval(loopTimer); loopTimer = null; }
      loopBtn.dataset.playing = 'false';
      loopBtn.textContent = '▶ Loop the progression';
    };

    const startLoop = () => {
      stopAll();
      let bar = 0;
      const barSec = baseBarSec / speed;
      const tick = () => loopBar(bar++, barSec);
      tick();
      loopTimer = window.setInterval(tick, barSec * 1000);
      loopBtn.dataset.playing = 'true';
      loopBtn.textContent = '■ Stop';
      stopActive = stopLoop;
    };

    loopBtn.addEventListener('click', () => (loopBtn.dataset.playing === 'true' ? stopAll() : startLoop()));

    speedBtns.forEach((b) => {
      b.addEventListener('click', () => {
        speed = parseFloat(b.dataset.speed || '1');
        speedBtns.forEach((x) => x.classList.toggle('is-active', x === b));
        if (hint) hint.textContent = `${Math.round((data.tempo || 72) * speed)} BPM · one chord per bar · sound on`;
        if (loopBtn.dataset.playing === 'true') startLoop(); // restart at new speed
      });
    });

    // ---- Improv sessions: accompaniment + a generated melody ----
    const UP = 12; // melody register: the voicing, one octave up
    const pcPool = [...new Set(chords.flatMap((c) => c.notes.map((m) => m % 12)))];
    const nearestPool = (target: number, avoid: number) => {
      let best = target;
      for (let d = 0; d <= 6; d++) {
        for (const cand of [target - d, target + d]) {
          if (pcPool.includes(((cand % 12) + 12) % 12) && cand !== avoid) return cand;
        }
      }
      return best;
    };
    const nearestChordTone = (from: number, c: ChordM) => {
      const tones = c.notes.map((m) => m + UP);
      return tones.reduce((a, b) => (Math.abs(b - from) < Math.abs(a - from) ? b : a));
    };
    // The "thread": the exact pitch shared by the most voicings this week.
    const counts = new Map<number, number>();
    chords.forEach((c) => c.notes.forEach((m) => counts.set(m, (counts.get(m) || 0) + 1)));
    const thread = [...counts.entries()].sort((a, b) => b[1] - a[1])[0]?.[0] ?? chords[0]?.notes[0] ?? 60;

    /** Schedule one bar of melody for session `si`; returns the last melody note. */
    function melodyBar(si: number, bar: number, t: number, beat: number, prev: number, rnd: () => number): number {
      const n = chords.length;
      const c = chords[bar % n];
      const next = chords[(bar + 1) % n];
      const posInPass = bar % n;
      if (si === 0) {
        // The held thread: re-strike the common tone; step down to close each pass.
        const m = thread + UP;
        note(m, t, beat * 2.2, 1.05);
        if (rnd() < 0.5) note(m, t + beat * 2, beat * 1.6, 0.8);
        if (posInPass === n - 1) {
          const fall = nearestChordTone(m - 2, c);
          note(fall === m ? m - 3 : fall, t + beat * 3, beat * 1.4, 0.95);
          return fall;
        }
        return m;
      }
      if (si === 1) {
        // Walking the changes: land a chord tone on 1, pass stepwise toward the next.
        const target = nearestChordTone(prev || chords[0].notes[chords[0].notes.length - 1] + UP, c);
        note(target, t, beat * 1.4, 1.05);
        const nextTarget = nearestChordTone(target, next);
        const dir = nextTarget >= target ? 1 : -1;
        const p1 = nearestPool(target + dir, target);
        note(p1, t + beat * 2, beat * 0.9, 0.8);
        if (rnd() < 0.65) note(nearestPool(p1 + dir, p1), t + beat * 3, beat * 0.9, 0.8);
        return nextTarget;
      }
      // Ask & answer: rise through the first half of the pass, fall and land after.
      const half = Math.ceil(n / 2);
      const tones = c.notes.map((m) => m + UP).sort((a, b) => a - b);
      if (posInPass < half) {
        // Question, ascending — and leave air at the top.
        tones.forEach((m, i) => { if (i < 3) note(m, t + beat * i, beat * 0.95, 0.95 + 0.05 * i); });
        return tones[Math.min(2, tones.length - 1)];
      }
      const landing = (c.color[0] !== undefined ? c.color[0] : c.notes[0]) + UP;
      if (posInPass === n - 1) {
        note(landing, t, beat * 3.4, 1.1); // the answer lands on the color
        return landing;
      }
      const down = [...tones].reverse();
      down.forEach((m, i) => { if (i < 3 && rnd() < 0.9) note(m, t + beat * i, beat * 0.95, 0.95); });
      return down[Math.min(2, down.length - 1)];
    }

    document.querySelectorAll<HTMLButtonElement>('.session-play').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      const si = parseInt(btn.dataset.session || '0', 10);
      let timer: number | null = null;
      const stopSession = () => {
        if (timer !== null) { clearInterval(timer); timer = null; }
        btn.dataset.playing = 'false';
        btn.textContent = '▶';
      };
      btn.addEventListener('click', () => {
        if (btn.dataset.playing === 'true') return stopAll();
        stopAll();
        const ac = getCtx();
        const barSec = baseBarSec;
        const beat = barSec / 4;
        const rnd = mulberry32((data.week || 1) * 97 + si * 131 + sessionNonce++);
        let bar = 0;
        let prev = 0;
        const tick = () => {
          const c = chords[bar % chords.length];
          const t = ac.currentTime + 0.03;
          // Accompaniment sits back so the melody reads as the voice on top.
          playChordM(c.bass, c.notes, t, barSec * 0.95, 0.7);
          playChordM(null, c.notes, t + barSec / 2, barSec * 0.4, 0.4);
          prev = melodyBar(si, bar, t, beat, prev, rnd);
          bar++;
        };
        tick();
        timer = window.setInterval(tick, barSec * 1000);
        btn.dataset.playing = 'true';
        btn.textContent = '■';
        stopActive = stopSession;
      });
    });

    document.addEventListener('astro:before-swap', stopAll, { once: true });
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .music-meta { display: flex; gap: var(--space-half); flex-wrap: wrap; max-width: none; }
  .meta-pill { font-size: var(--fs-eyebrow); font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: var(--sage-deep); background: var(--sage-wash); padding: 0.3em 0.9em; border-radius: var(--radius-pill); }

  .week-section { margin-block: var(--space-3); }
  .section-head { display: flex; align-items: center; gap: var(--space-half); font-size: var(--fs-h2); margin-bottom: var(--space-1); }
  .section-icon { display: inline-flex; width: 2.4rem; height: 2.4rem; padding: 0.5rem; border-radius: var(--radius-pill); background: var(--sage-wash); color: var(--sage-deep); flex-shrink: 0; }
  .section-icon :global(svg) { width: 100%; height: 100%; }
  .section-intro { color: var(--text-secondary); max-width: none; margin-bottom: var(--space-1); }
  .sub-head { margin-top: var(--space-2); }

  .loop-bar { display: flex; align-items: center; gap: var(--space-1); flex-wrap: wrap; padding: var(--space-1) var(--space-2); margin-bottom: var(--space-2); }
  .loop-hint { font-size: var(--fs-small); color: var(--text-secondary); }

  .speed-group { display: inline-flex; border: 1.5px solid var(--border-hairline); border-radius: var(--radius-pill); overflow: hidden; }
  .speed-btn {
    font-size: var(--fs-small);
    font-weight: 800;
    padding: 0.35em 0.9em;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .speed-btn + .speed-btn { border-left: 1.5px solid var(--border-hairline); }
  .speed-btn:hover { color: var(--sage-deep); }
  .speed-btn.is-active { background: var(--sage); color: #fff; }

  .session-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-1); }
  .session { display: flex; gap: var(--space-1); align-items: flex-start; padding: var(--space-1) var(--space-2); border-left: 4px solid var(--sage); }
  .session-play { flex-shrink: 0; width: 2.6rem; height: 2.6rem; border: none; border-radius: var(--radius-pill); background: var(--sage); color: #fff; font-size: 1rem; cursor: pointer; transition: transform 0.2s var(--ease-spring), background 0.2s; }
  .session-play:hover { background: var(--sage-deep); transform: scale(1.08); }
  .session-play[data-playing='true'] { background: var(--rose-deep); }
  .session-name { margin: 0.2rem 0 0.25rem; font-weight: 800; }
  .session-blurb { margin: 0; color: var(--text-secondary); font-size: var(--fs-small); max-width: none; }

  .chord-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-1); }
  .chord { padding: var(--space-1) var(--space-2); }
  .chord-head { display: flex; gap: var(--space-1); align-items: flex-start; }
  .chord-play { flex-shrink: 0; width: 2.6rem; height: 2.6rem; border: none; border-radius: var(--radius-pill); background: var(--sage); color: #fff; font-size: 1rem; cursor: pointer; transition: transform 0.2s var(--ease-spring), background 0.2s; }
  .chord-play:hover { background: var(--sage-deep); transform: scale(1.08); }
  .chord-symbol { margin: 0.2rem 0 0.2rem; font-family: var(--font-heading); font-weight: 600; font-size: var(--fs-h3); }
  .chord-roman { font-size: 0.95rem; color: var(--sage-deep); font-weight: 700; margin-left: 0.4rem; }
  .chord-why { margin: 0; color: var(--text-secondary); max-width: none; }

  .legend { display: flex; gap: var(--space-1); align-items: center; flex-wrap: wrap; font-size: var(--fs-small); color: var(--text-secondary); margin-top: var(--space-1); }
  .lg { display: inline-block; width: 0.9rem; height: 0.9rem; border-radius: 3px; }
  .lg-bass { background: var(--sage-deep); }
  .lg-tone { background: var(--sage); }
  .lg-color { background: var(--rose); }

  .steps-list { padding-left: 1.4rem; max-width: none; }
  .steps-list li { margin-bottom: var(--space-half); }
  .lh-pattern { padding: var(--space-1) var(--space-2); max-width: none; }

  .tools-list { padding-left: 1.4rem; max-width: none; }
  .tools-list li { margin-bottom: 0.35rem; }

