---
import ContentLayout from '../layouts/ContentLayout.astro';
import Sprout from '../components/illustrations/Sprout.astro';
import MilestoneGlyph from '../components/illustrations/MilestoneGlyph.astro';
import { MILESTONES, AGE_BANDS, type Milestone } from '../data/milestone-journey';
import { LIFE_ANCHOR, isPreBirth } from '../lib/current-week';

/**
 * The milestone journey — one vine, two years, every first.
 * Majors bloom big (photo in the petals once achieved); minors are buds that
 * unfurl on tap. The vine draws itself in as you scroll, and Sprout waits at
 * "Cody is here." Supersedes the old month-stop index (2026-07-30); month
 * pages remain the cited, evidence-based detail behind each bloom's link.
 */

const now = new Date();
const ageDays = Math.max(0, Math.floor((now.getTime() - LIFE_ANCHOR.getTime()) / 86400000)) + 1;
const ageMonths = isPreBirth(now) ? 0 : ageDays / 30.4375;
const ageLabel = ageDays < 60 ? `${ageDays} days old` : `${Math.floor(ageMonths)} months old`;

type Node =
  | { kind: 'band'; pos: number; label: string }
  | { kind: 'here'; pos: number }
  | { kind: 'ms'; pos: number; ms: Milestone };

const nodes: Node[] = [
  ...AGE_BANDS.map((b) => ({ kind: 'band' as const, pos: b.month - 0.001, label: b.label })),
  { kind: 'here' as const, pos: ageMonths },
  ...MILESTONES.map((ms) => ({ kind: 'ms' as const, pos: ms.window[0] + (ms.tier === 'minor' ? 0.4 : 0.2), ms })),
].sort((a, b) => a.pos - b.pos);

const windowLabel = (w: [number, number]) => (w[0] === 0 ? `birth – ${w[1]} mo` : `${w[0]}–${w[1]} mo`);
const dateLabel = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString('en-CA', { month: 'long', day: 'numeric', year: 'numeric' });

const achievedCount = MILESTONES.filter((m) => m.achieved).length;
let side = 0; // alternate milestone cards left/right of the vine
---

<ContentLayout
  eyebrow="Milestone journey"
  title="Two years, one vine"
  description={`Every big first (and the little ones between) from birth to two — blooming as Cody gets there. ${achievedCount} bloomed so far.`}
  wide
>
  <p class="journey-note reveal">
    Big blossoms are the major milestones; the small buds are minor ones — <strong>tap a bud
    to open it</strong>. Windows are wide on purpose: babies read their own calendars, and
    the linked month pages carry the properly-sourced details. This is a garden, not a
    scorecard.
  </p>

  <div class="vinewrap" id="vinewrap">
    <div class="vinetrack" aria-hidden="true"><div class="vinefill" id="vinefill"></div></div>

    <ol class="journey">
      {nodes.map((n) => {
        if (n.kind === 'band') {
          return (
            <li class="band reveal">
              <span class="band-pill">{n.label}</span>
            </li>
          );
        }
        if (n.kind === 'here') {
          return (
            <li class="here reveal" id="here">
              <span class="here-sprout"><Sprout width={72} /></span>
              <span class="here-pill">Cody is here — {ageLabel}</span>
            </li>
          );
        }
        const ms = n.ms;
        const s = side++;
        if (ms.tier === 'major') {
          return (
            <li class:list={['node', 'major', s % 2 ? 'right' : 'left', { achieved: !!ms.achieved }]}>
              <span class="stem" aria-hidden="true"></span>
              <div class="bloom-card">
                <div class="bloom" aria-hidden="true">
                  {Array.from({ length: 8 }, (_, i) => (
                    <span class="petal" style={`--i:${i}; --a:${i * 45}deg`}></span>
                  ))}
                  <span class="bloom-center">
                    {ms.achieved?.photo ? (
                      <img src={`/api/capture-photo/thumb-${ms.achieved.photo}`} alt="" loading="lazy" />
                    ) : (
                      <MilestoneGlyph icon={ms.icon} size={78} />
                    )}
                  </span>
                  {ms.achieved && (
                    <span class="sparkles" aria-hidden="true">
                      {Array.from({ length: 6 }, (_, i) => (
                        <i style={`--s:${i}`}></i>
                      ))}
                    </span>
                  )}
                </div>
                <div class="bloom-text">
                  <p class="ms-window">{ms.achieved ? `✓ ${dateLabel(ms.achieved.date)}` : `usually ${windowLabel(ms.window)}`}</p>
                  <h2 class="ms-title">{ms.title}</h2>
                  <p class="ms-about">{ms.achieved?.note ?? ms.about}</p>
                  {ms.link && <a class="ms-link" href={ms.link}>The full story of this age &rarr;</a>}
                </div>
              </div>
            </li>
          );
        }
        return (
          <li class:list={['node', 'minor', s % 2 ? 'right' : 'left', { achieved: !!ms.achieved }]}>
            <span class="stem" aria-hidden="true"></span>
            <div class="bud-card">
              <button type="button" class="bud" aria-expanded="false">
                <span class="bud-dot" aria-hidden="true"></span>
                <span class="bud-title">{ms.title}</span>
                <span class="bud-when">{ms.achieved ? `✓ ${dateLabel(ms.achieved.date)}` : windowLabel(ms.window)}</span>
              </button>
              <div class="bud-body">
                <div class="bud-inner">
                  <MilestoneGlyph icon={ms.icon} size={46} />
                  <p>{ms.achieved?.note ?? ms.about}</p>
                </div>
              </div>
            </div>
          </li>
        );
      })}
      <li class="band reveal vine-end">
        <span class="band-pill">…and we're only getting started</span>
      </li>
    </ol>
  </div>
</ContentLayout>

<script>
  function init() {
    const wrap = document.getElementById('vinewrap');
    const fill = document.getElementById('vinefill');
    if (!wrap || !fill || wrap.dataset.bound) return;
    wrap.dataset.bound = '1';

    // The vine draws itself in as you scroll.
    const grow = () => {
      const r = wrap.getBoundingClientRect();
      const viewH = window.innerHeight;
      const progress = Math.min(1, Math.max(0, (viewH * 0.75 - r.top) / r.height));
      fill.style.height = `${progress * 100}%`;
    };
    grow();
    window.addEventListener('scroll', grow, { passive: true });
    window.addEventListener('resize', grow, { passive: true });

    // Blooms open and buds pop as they enter the view (and stay open).
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) e.target.classList.add('in-view');
        }),
      { rootMargin: '0px 0px -12% 0px', threshold: 0.2 }
    );
    wrap.querySelectorAll('.node, .band, .here').forEach((el) => io.observe(el));

    // Buds unfurl on tap.
    wrap.querySelectorAll<HTMLButtonElement>('.bud').forEach((btn) => {
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        btn.closest('.bud-card')?.classList.toggle('open', !open);
      });
    });
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .journey-note {
    background: var(--sage-wash);
    border-radius: var(--radius-card);
    padding: var(--space-1) var(--space-2);
    color: var(--text-secondary);
    max-width: 44rem;
    margin-inline: auto;
  }

  .vinewrap { position: relative; max-width: 52rem; margin: var(--space-3) auto 0; }

  /* ---- the vine itself ---- */
  .vinetrack {
    position: absolute;
    top: 0; bottom: 0; left: 50%;
    width: 6px;
    transform: translateX(-50%);
    background: color-mix(in srgb, var(--sage) 18%, transparent);
    border-radius: 3px;
    overflow: hidden;
  }
  .vinefill {
    width: 100%; height: 0%;
    background: linear-gradient(to bottom, var(--sage) 0%, var(--sage-deep) 100%);
    border-radius: 3px;
    transition: height 0.25s linear;
    position: relative;
  }
  .vinefill::after {
    content: '';
    position: absolute; bottom: -3px; left: 50%;
    width: 14px; height: 14px;
    transform: translateX(-50%);
    background: radial-gradient(circle, var(--sage-deep) 35%, transparent 70%);
    border-radius: 50%;
  }

  .journey { list-style: none; margin: 0; padding: var(--space-2) 0 var(--space-4); display: flex; flex-direction: column; gap: var(--space-3); }

  /* ---- age bands + the here-marker ---- */
  .band { display: flex; justify-content: center; position: relative; z-index: 2; }
  .band-pill {
    font-size: var(--fs-eyebrow); font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--sage-deep); background: var(--paper);
    border: 1.5px solid color-mix(in srgb, var(--sage) 40%, #fff);
    border-radius: var(--radius-pill); padding: 0.45em 1.2em;
    box-shadow: 0 1px 0 color-mix(in srgb, var(--sage) 20%, transparent);
  }

  .here { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; position: relative; z-index: 2; }
  .here-sprout { animation: bob 3.2s ease-in-out infinite; }
  .here-pill {
    font-weight: 800; font-size: var(--fs-small); color: #fff;
    background: var(--sage-deep); border-radius: var(--radius-pill); padding: 0.4em 1.1em;
    box-shadow: var(--shadow-lifted, 0 6px 18px rgba(0, 0, 0, 0.12));
  }
  @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }

  /* ---- shared node layout: cards branch off the vine ---- */
  .node { position: relative; display: flex; }
  .node.left { justify-content: flex-start; padding-right: calc(50% + 2rem); }
  .node.right { justify-content: flex-end; padding-left: calc(50% + 2rem); }
  .stem {
    position: absolute; top: 3.2rem; width: 2rem; height: 3px;
    background: color-mix(in srgb, var(--sage) 45%, transparent); border-radius: 2px;
  }
  .node.left .stem { right: 50%; }
  .node.right .stem { left: 50%; }

  /* ---- majors: the blooms ---- */
  .bloom-card {
    display: flex; gap: var(--space-2); align-items: flex-start;
    background: var(--paper); border-radius: var(--radius-card);
    padding: var(--space-2);
    box-shadow: 0 2px 14px color-mix(in srgb, var(--sage-deep) 10%, transparent);
    max-width: 30rem;
    opacity: 0; transform: translateY(22px);
    transition: opacity 0.6s ease, transform 0.6s var(--ease-spring, cubic-bezier(0.34, 1.4, 0.64, 1));
  }
  .node.right .bloom-card { flex-direction: row-reverse; text-align: right; }
  .node.in-view .bloom-card { opacity: 1; transform: none; }

  .bloom { position: relative; width: 8.5rem; height: 8.5rem; flex-shrink: 0; }
  .petal {
    position: absolute; top: 50%; left: 50%;
    width: 2.9rem; height: 4.4rem; margin: -2.2rem 0 0 -1.45rem;
    border-radius: 50% 50% 46% 46%;
    background: linear-gradient(to top, color-mix(in srgb, var(--sage) 55%, #fff), color-mix(in srgb, var(--sage) 25%, #fff));
    transform: rotate(var(--a)) translateY(-0.6rem) scale(0.15);
    transform-origin: 50% 100%;
    opacity: 0;
    transition: transform 0.7s var(--ease-spring, cubic-bezier(0.34, 1.4, 0.64, 1)), opacity 0.4s ease;
    transition-delay: calc(var(--i) * 55ms + 150ms);
  }
  .node.achieved .petal {
    background: linear-gradient(to top, var(--rose), color-mix(in srgb, var(--rose) 45%, #fff));
  }
  .node.in-view .petal { transform: rotate(var(--a)) translateY(-2.55rem) scale(1); opacity: 1; }

  .bloom-center {
    position: absolute; top: 50%; left: 50%;
    width: 5.4rem; height: 5.4rem; transform: translate(-50%, -50%) scale(0.6);
    border-radius: 50%; overflow: hidden;
    background: #fff;
    border: 3px solid color-mix(in srgb, var(--butter) 70%, #fff);
    display: grid; place-items: center;
    transition: transform 0.7s var(--ease-spring, cubic-bezier(0.34, 1.4, 0.64, 1)) 0.35s;
    z-index: 2;
  }
  .node.in-view .bloom-center { transform: translate(-50%, -50%) scale(1); }
  .bloom-center img { width: 100%; height: 100%; object-fit: cover; }

  /* achieved blooms shimmer a little */
  .sparkles i {
    position: absolute; top: 50%; left: 50%;
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--butter);
    opacity: 0;
  }
  .node.in-view .sparkles i {
    animation: sparkle 2.8s ease-in-out infinite;
    animation-delay: calc(var(--s) * 0.45s);
    transform: rotate(calc(var(--s) * 60deg)) translateY(-4.7rem);
  }
  @keyframes sparkle {
    0%, 100% { opacity: 0; scale: 0.4; }
    50% { opacity: 0.9; scale: 1; }
  }

  .bloom-text { min-width: 0; }
  .ms-window { margin: 0 0 0.2rem; font-size: var(--fs-eyebrow); font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--sage-deep); }
  .node.achieved .ms-window { color: var(--rose-deep); }
  .ms-title { margin: 0 0 0.35rem; font-size: var(--fs-h3); font-weight: 600; }
  .ms-about { margin: 0; color: var(--text-secondary); font-size: 0.95rem; line-height: 1.55; max-width: none; }
  .ms-link { display: inline-block; margin-top: 0.5rem; font-weight: 700; font-size: var(--fs-small); color: var(--sage-deep); text-decoration: none; }
  .ms-link:hover { text-decoration: underline; }

  /* ---- minors: the buds ---- */
  .bud-card {
    max-width: 24rem; width: 100%;
    opacity: 0; transform: translateY(16px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .node.in-view .bud-card { opacity: 1; transform: none; }
  .bud {
    display: flex; align-items: center; gap: 0.6rem;
    width: 100%;
    background: var(--paper); border: 1.5px solid color-mix(in srgb, var(--sage) 30%, #fff);
    border-radius: var(--radius-pill);
    padding: 0.5rem 1rem;
    cursor: pointer; text-align: left;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s var(--ease-spring, ease);
  }
  .bud:hover { border-color: var(--sage); transform: scale(1.02); box-shadow: 0 3px 12px color-mix(in srgb, var(--sage-deep) 12%, transparent); }
  .node.right .bud { flex-direction: row-reverse; text-align: right; }
  .bud-dot {
    flex-shrink: 0; width: 1.05rem; height: 1.05rem; border-radius: 50% 50% 50% 4px;
    background: linear-gradient(135deg, var(--sage), var(--sage-deep));
    transform: rotate(45deg);
    transition: transform 0.4s var(--ease-spring, ease), background 0.3s;
  }
  .node.achieved .bud-dot { background: linear-gradient(135deg, var(--rose), var(--rose-deep)); }
  .bud-card.open .bud-dot { transform: rotate(225deg) scale(1.15); }
  .bud-title { font-weight: 700; font-size: 0.95rem; }
  .bud-when { margin-left: auto; font-size: var(--fs-eyebrow); font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-secondary); white-space: nowrap; }
  .node.right .bud-when { margin-left: 0; margin-right: auto; }
  .node.achieved .bud-when { color: var(--rose-deep); }

  .bud-body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.45s var(--ease-spring, ease); }
  .bud-card.open .bud-body { grid-template-rows: 1fr; }
  .bud-inner { overflow: hidden; display: flex; gap: 0.8rem; align-items: flex-start; }
  .bud-card.open .bud-inner { padding: 0.8rem 0.5rem 0.2rem; }
  .node.right .bud-inner { flex-direction: row-reverse; text-align: right; }
  .bud-inner p { margin: 0; color: var(--text-secondary); font-size: var(--fs-small); line-height: 1.55; max-width: none; }
  .bud-inner :global(svg) { flex-shrink: 0; }

  .vine-end { padding-top: var(--space-1); }

  /* ---- mobile: single column, vine on the left ---- */
  @media (max-width: 700px) {
    .vinetrack { left: 1.1rem; transform: none; }
    .node.left, .node.right { justify-content: flex-start; padding: 0 0 0 3rem; }
    .node.left .stem, .node.right .stem { left: 1.1rem; right: auto; width: 1.6rem; }
    .node.right .bloom-card { flex-direction: row; text-align: left; }
    .node.right .bud { flex-direction: row; text-align: left; }
    .node.right .bud-when { margin-left: auto; margin-right: 0; }
    .node.right .bud-inner { flex-direction: row; text-align: left; }
    .bloom-card { flex-direction: column; }
    .band, .here { justify-content: flex-start; padding-left: 3rem; align-items: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bloom-card, .bud-card, .petal, .bloom-center { transition: none; }
    .here-sprout, .sparkles i { animation: none; }
    .sparkles i { opacity: 0.7; transform: rotate(calc(var(--s) * 60deg)) translateY(-4.7rem); }
    .vinefill { transition: none; height: 100% !important; }
  }
</style>
