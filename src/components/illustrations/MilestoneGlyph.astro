  ball: `<circle cx="24" cy="24" r="12" fill="#fff" stroke="${DEEP}" stroke-width="1.8"/><path d="M24 12a26 26 0 0 0 0 24M12.5 20a24 24 0 0 0 23 0M12.5 28a24 24 0 0 1 23 0" fill="none" stroke="${ROSED}" stroke-width="1.6"/>`,
  book: `<path d="M24 14c-3-2.5-8-3-13-2v22c5-1 10-.5 13 2 3-2.5 8-3 13-2V12c-5-1-10-.5-13 2z" fill="#fff" stroke="${DEEP}" stroke-width="1.8" stroke-linejoin="round"/><path d="M24 14v22" stroke="${DEEP}" stroke-width="1.4"/><path d="M15 18.5c2-.4 4-.4 6 .1M15 23c2-.4 4-.4 6 .1M27 18.6c2-.5 4-.5 6-.1M27 23.1c2-.5 4-.5 6-.1" stroke="${SAGE}" stroke-width="1.5" stroke-linecap="round"/>`,
