const inner = G[icon] ?? G.star;
---

<svg viewBox="0 0 48 48" width={size} height={size} aria-hidden="true" class="ms-glyph">
  <circle cx="24" cy="24" r="23" fill="color-mix(in srgb, var(--butter, #F2D8A7) 30%, #fff)" />
  <Fragment set:html={inner} />
</svg>
