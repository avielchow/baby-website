const BUTTER = 'var(--butter, #F2D8A7)';
const INK = 'var(--ink, #3D443A)';

// Each glyph is inner SVG markup drawn in a 48x48 box (badge circle added below).
const G: Record<string, string> = {
  smile: `<circle cx="24" cy="24" r="13" fill="${BUTTER}"/><circle cx="19" cy="21" r="1.8" fill="${INK}"/><circle cx="29" cy="21" r="1.8" fill="${INK}"/><path d="M17.5 27c2 3 11 3 13 0" stroke="${INK}" stroke-width="2" fill="none" stroke-linecap="round"/><circle cx="15.5" cy="25" r="2.2" fill="${ROSE}" opacity="0.8"/><circle cx="32.5" cy="25" r="2.2" fill="${ROSE}" opacity="0.8"/>`,
  laugh: `<circle cx="24" cy="24" r="13" fill="${BUTTER}"/><path d="M16.5 20.5l4 1.5M31.5 20.5l-4 1.5" stroke="${INK}" stroke-width="1.8" stroke-linecap="round"/><path d="M17 26c2.5 5.5 11.5 5.5 14 0z" fill="${INK}"/><path d="M19.5 29.5c2.5 1.6 6.5 1.6 9 0" fill="${ROSE}"/>`,
  eyes: `<ellipse cx="17" cy="24" rx="6.5" ry="8" fill="#fff" stroke="${DEEP}" stroke-width="1.6"/><ellipse cx="31" cy="24" rx="6.5" ry="8" fill="#fff" stroke="${DEEP}" stroke-width="1.6"/><circle cx="18.5" cy="26" r="2.6" fill="${INK}"/><circle cx="32.5" cy="26" r="2.6" fill="${INK}"/><path d="M12 14c2-2 5-3 8-2M28 12c3-1 6 0 8 2" stroke="${SAGE}" stroke-width="1.8" fill="none" stroke-linecap="round"/>`,
  bubble: `<path d="M10 20a10 8.5 0 0 1 10-8.5h8A10 8.5 0 0 1 38 20a10 8.5 0 0 1-10 8.5h-3l-6 6v-6.6A10 8.5 0 0 1 10 20z" fill="#fff" stroke="${DEEP}" stroke-width="1.8"/><circle cx="18" cy="20" r="1.7" fill="${ROSED}"/><circle cx="24" cy="20" r="1.7" fill="${ROSED}"/><circle cx="30" cy="20" r="1.7" fill="${ROSED}"/>`,
  hand: `<path d="M18 30V17a2.2 2.2 0 0 1 4.4 0v6m0-8a2.2 2.2 0 0 1 4.4 0v8m0-6a2.2 2.2 0 0 1 4.4 0v7m0-4a2.2 2.2 0 0 1 4.4 0v8c0 6-4 10-9.5 10S18 36 18 30z" fill="${BUTTER}" stroke="${INK}" stroke-width="1.7" stroke-linejoin="round"/><circle cx="13" cy="18" r="2" fill="${ROSE}"/>`,
  star: `<path d="M24 10l3.6 8 8.4 1-6.2 5.8 1.8 8.6-7.6-4.4-7.6 4.4 1.8-8.6L12 19l8.4-1z" fill="${BUTTER}" stroke="${ROSED}" stroke-width="1.6" stroke-linejoin="round"/><circle cx="21.5" cy="21.5" r="1.3" fill="${INK}"/><circle cx="26.5" cy="21.5" r="1.3" fill="${INK}"/><path d="M21.5 25c1.3 1.4 3.7 1.4 5 0" stroke="${INK}" stroke-width="1.5" fill="none" stroke-linecap="round"/>`,
