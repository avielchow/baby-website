  scribble: `<rect x="11" y="12" width="26" height="24" rx="2.5" fill="#fff" stroke="${DEEP}" stroke-width="1.7"/><path d="M15 28c3-8 5 6 8-3s4 5 7-4 4 3 4 3" fill="none" stroke="${ROSED}" stroke-width="2.2" stroke-linecap="round"/><rect x="28" y="30" width="10" height="4" rx="2" transform="rotate(-35 28 30)" fill="${BUTTER}" stroke="${INK}" stroke-width="1.1"/>`,
