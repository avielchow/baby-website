  clap: `<path d="M16 30l6-13 3 1.2-4.5 12.8z" fill="${BUTTER}" stroke="${INK}" stroke-width="1.4" stroke-linejoin="round"/><path d="M32 30l-6-13-3 1.2 4.5 12.8z" fill="${BUTTER}" stroke="${INK}" stroke-width="1.4" stroke-linejoin="round"/><path d="M24 10v3M17 12l1.5 2.6M31 12l-1.5 2.6" stroke="${ROSED}" stroke-width="2" stroke-linecap="round"/><circle cx="24" cy="34" r="2.4" fill="${ROSE}"/>`,
  word: `<path d="M9 19a9 8 0 0 1 9-8h12a9 8 0 0 1 9 8 9 8 0 0 1-9 8h-4l-7 7v-7.2A9 8 0 0 1 9 19z" fill="${SAGE}"/><path d="M24 15.5s-3.4-3.4-5.6-1.2c-2 2-.2 4.4 5.6 8 5.8-3.6 7.6-6 5.6-8-2.2-2.2-5.6 1.2-5.6 1.2z" fill="#fff"/>`,
  point: `<path d="M13 26h13M26 26a2.4 2.4 0 1 0 0-4.8H21" fill="none" stroke="${INK}" stroke-width="1.7" stroke-linecap="round"/><path d="M13 21.5v9a6.5 6.5 0 0 0 6.5 6.5h5A6.5 6.5 0 0 0 31 30v-2" fill="${BUTTER}" stroke="${INK}" stroke-width="1.7" stroke-linejoin="round"/><path d="M33 16l4-4M35 20l5-1M30 13.5l1-5" stroke="${ROSED}" stroke-width="2" stroke-linecap="round"/>`,
  steps: `<path d="M14 32c-2.6 0-4.5-2.2-4.2-4.8.3-2.4 2.2-4.2 4.6-4.2 2.6 0 4.4 2 4.2 4.6-.1 2.4-2 4.4-4.6 4.4z" fill="${SAGE}"/><ellipse cx="12.4" cy="20.6" rx="1.4" ry="1.9" fill="${SAGE}"/><ellipse cx="15.6" cy="19.8" rx="1.3" ry="1.8" fill="${SAGE}"/><ellipse cx="18.4" cy="20.8" rx="1.2" ry="1.6" fill="${SAGE}"/><path d="M34 40c2.6 0 4.5-2.2 4.2-4.8-.3-2.4-2.2-4.2-4.6-4.2-2.6 0-4.4 2-4.2 4.6.1 2.4 2 4.4 4.6 4.4z" fill="${ROSED}"/><ellipse cx="35.6" cy="28.6" rx="1.4" ry="1.9" fill="${ROSED}"/><ellipse cx="32.4" cy="27.8" rx="1.3" ry="1.8" fill="${ROSED}"/><ellipse cx="29.6" cy="28.8" rx="1.2" ry="1.6" fill="${ROSED}"/>`,
