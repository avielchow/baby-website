---
/**
 * Cute placeholder art for milestone-journey nodes — one small badge glyph
 * per milestone category, in the site palette. These live inside blooms and
 * buds until a real capture photo replaces them (majors only get photos).
 */
interface Props {
  icon: string;
  size?: number;
}
const { icon, size = 64 } = Astro.props;

const SAGE = 'var(--sage, #6B9A5F)';
const DEEP = 'var(--sage-deep, #557B4B)';
const ROSE = 'var(--rose, #E8B4B4)';
