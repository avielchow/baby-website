---
/**
 * Renders a recovery page's sections — same rich-bullet + inline source-chip
 * pattern as the week pages (docs/CONTENT.md), with tones: default (sage),
 * flag (rose, urgent "call now" content), forceps (the assisted-birth track,
 * badged so it reads as its own path).
 */
import VideoCard from './VideoCard.astro';

interface SourceRef { label: string; url?: string }
interface Item {
  title: string;
  detail?: string;
  sources: SourceRef[];
  video?: { title: string; url: string; channel: string };
}
interface Section {
  key: string;
  label: string;
  intro?: string;
  tone: 'default' | 'flag' | 'forceps';
  items: Item[];
}

interface Props {
  sections: Section[];
}

const { sections } = Astro.props;

const icons: Record<string, string> = {
  default: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.5-9-9a5 5 0 0 1 9-3 5 5 0 0 1 9 3c-2 4.5-9 9-9 9z"/></svg>',
  flag: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>',
  forceps: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18M7 8c0 3 2 5 5 5s5-2 5-5"/><path d="M8 21h8"/></svg>',
};
---

{sections.map((section) => (
  section.items.length > 0 && (
    <section class:list={['recovery-section', 'reveal', `tone-${section.tone}`]} id={section.key}>
      <h2 class:list={['section-head', { 'is-flag': section.tone === 'flag', 'is-forceps': section.tone === 'forceps' }]}>
        <span class="section-icon" set:html={icons[section.tone]} />
        {section.label}
      </h2>
      {section.intro && <p class="section-intro">{section.intro}</p>}
      <ul class="bullet-list">
        {section.items.map((item) => (
          <li class="bullet">
            <p class="bullet-title">{item.title}</p>
            {item.detail && <p class="bullet-detail">{item.detail}</p>}
            {item.sources.length > 0 && (
              <p class="bullet-sources">
                {item.sources.map((s) =>
                  s.url ? (
                    <a class="source-chip" href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
                  ) : (
                    <span class="source-chip">{s.label}</span>
                  )
                )}
              </p>
            )}
            {item.video && <VideoCard title={item.video.title} url={item.video.url} channel={item.video.channel} />}
          </li>
        ))}
      </ul>
    </section>
  )
))}

<style>
  .recovery-section {
    margin-block: var(--space-3);
  }

  .section-head {
    display: flex;
    align-items: center;
    gap: var(--space-half);
    font-size: var(--fs-h2);
    margin-bottom: var(--space-1);
  }

  .section-icon {
    display: inline-flex;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--sage-wash);
    color: var(--sage-deep);
    flex-shrink: 0;
  }

  .section-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .section-head.is-flag .section-icon {
    background: color-mix(in srgb, var(--rose) 30%, #fff);
    color: var(--rose-deep);
  }

  .section-head.is-forceps .section-icon {
    background: color-mix(in srgb, var(--sage-deep) 18%, #fff);
    color: var(--sage-deep);
  }

  /* The urgent section carries a soft rose card so it can't be scrolled past. */
  .tone-flag {
    background: color-mix(in srgb, var(--rose) 10%, #fff);
    border-left: 4px solid var(--rose-deep);
    border-radius: var(--radius-card);
    padding: var(--space-2);
  }

  .tone-forceps {
    border-left: 4px solid var(--sage-deep);
    border-radius: var(--radius-card);
    padding-left: var(--space-2);
  }

  .section-intro {
    color: var(--text-secondary);
    margin: 0 0 var(--space-1);
    max-width: none;
  }

  .bullet-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .bullet-title {
    font-weight: 700;
    margin: 0 0 0.35rem;
  }

  .bullet-detail {
    margin: 0;
    color: var(--text-secondary);
    max-width: none;
  }

  .bullet-sources {
    margin: 0.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .source-chip {
    font-size: var(--fs-eyebrow);
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--sage-deep);
    background: var(--sage-wash);
    border-radius: var(--radius-pill);
    padding: 0.2em 0.7em;
    text-decoration: none;
  }

  a.source-chip:hover {
    background: var(--sage);
    color: #fff;
  }
</style>
